# ---------- Required ----------
# Postgres connection (Neon free tier in production). Local: postgresql://user:pass@localhost:5432/db
DATABASE_URL=""
# Neon only: the direct (non-pooled) connection string, used to apply database migrations during deploy.
DIRECT_URL=""
# Public URL of the app, e.g. https://reviews.example.com (https required in production)
APP_URL="http://localhost:3000"
# 32 random bytes, base64. Encrypts customer phone numbers and emails. Generate: openssl rand -base64 32
# Never change it after launch, or stored phone numbers can't be read.
FIELD_ENCRYPTION_KEY=""
# Random string (32+ chars) for hashing IPs and device ids. Generate: openssl rand -base64 48
HASH_SECRET=""
# Random string (24+ chars). GitHub Actions sends it to the scheduled-job endpoints.
CRON_SECRET=""
# Comma-separated Google emails that are platform owners (Synergy Technologies staff).
PLATFORM_OWNER_EMAILS=""

# ---------- Printed QR codes ----------
# Address printed inside QR codes: the Cloudflare Worker, e.g. https://go.synergytech.workers.dev
# Leave empty during development to use APP_URL/r/<code>.
QR_BASE_URL=""

# ---------- Google sign-in (required in production) ----------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Local development only: shows an email sign-in form. Ignored in production builds.
DEV_LOGIN_ENABLED="false"

# ---------- Cloudflare Turnstile captcha (required in production) ----------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Customer photos: Cloudflare R2 (recommended in production) ----------
# Free 10 GB. Without these, photos are stored in the database (fine for testing, fills the free 0.5 GB faster).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# ---------- Email alerts (one of the two is required in production) ----------
# Option 1: Gmail / Google Workspace mailbox with an app password (Google Account → Security → App passwords).
# EMAIL_FROM must be this same mailbox, or Gmail rewrites the sender.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Option 2: Resend (needs DNS records on your domain). Used only when SMTP_USER/SMTP_PASSWORD are empty.
RESEND_API_KEY=""
EMAIL_FROM="Smart Review Alerts <donotreply@your-domain.com>"

# ---------- AI suggestions ----------
# Default provider: GEMINI, ANTHROPIC, OPENAI or MOCK (offline templates). Changeable later in Platform settings.
AI_PROVIDER="GEMINI"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-4-5"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
